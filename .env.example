PORT=3000
SITE_URL=https://hireebridge.in
GREYROCKS_URL=https://greyrocks.in
SUPPORT_EMAIL=help@hireebridge.in

# Database (Neon PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@ep-xyz.region.neon.tech/dbname?sslmode=require
NEON_DB=postgresql://user:password@ep-xyz.region.neon.tech/dbname?sslmode=require

# Administrative Authentication
ADMIN_EMAIL=admin@hireebridge.in
ADMIN_PASSWORD=YourSecureAdminPasswordHere
SUPER_ADMIN_KEY=YourSuperAdminSecretKeyForDestructiveActions

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Transactional Email (Brevo / Nodemailer)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_login
SMTP_PASS=your_smtp_key
MAIL_FROM=HireeBridge <sender@hireebridge.in>
EMAIL_DAILY_LIMIT=300

# Security and Rate Limiting
PASSWORD_RESET_TOKEN_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_WINDOW_MINUTES=15
FORGOT_PASSWORD_IP_MAX=5
FORGOT_PASSWORD_IP_WINDOW_MINUTES=15
FORGOT_PASSWORD_EMAIL_MAX=3
FORGOT_PASSWORD_EMAIL_WINDOW_MINUTES=60
FORGOT_PASSWORD_EMAIL_COOLDOWN_MINUTES=5

# Cloudflare R2 Certificate Storage
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=hireebridge-certificates-prod
R2_STORAGE_LIMIT_GB=9